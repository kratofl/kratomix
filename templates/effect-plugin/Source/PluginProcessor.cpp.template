#include "PluginProcessor.h"
#include "PluginEditor.h"

namespace
{
constexpr auto stateId = "Parameters";
constexpr auto trimId = "trim";
constexpr auto bypassId = "bypass";
}

namespace kratomix
{
EffectPluginAudioProcessor::EffectPluginAudioProcessor()
    : AudioProcessor(BusesProperties()
          .withInput("Input", juce::AudioChannelSet::stereo(), true)
          .withOutput("Output", juce::AudioChannelSet::stereo(), true)),
      parameters(*this, nullptr, stateId, createParameterLayout())
{
}

juce::AudioProcessorValueTreeState::ParameterLayout EffectPluginAudioProcessor::createParameterLayout()
{
    using Parameter = juce::RangedAudioParameter;
    std::vector<std::unique_ptr<Parameter>> parametersList;

    const auto displayDb = [](float value, int)
    {
        return juce::String(value, 1);
    };

    const auto parseDb = [](const juce::String& text)
    {
        return text.getFloatValue();
    };

    parametersList.push_back(std::make_unique<juce::AudioParameterFloat>(
        juce::ParameterID { trimId, 1 },
        "Trim",
        juce::NormalisableRange<float>(-18.0f, 18.0f, 0.1f),
        0.0f,
        juce::AudioParameterFloatAttributes()
            .withStringFromValueFunction(displayDb)
            .withValueFromStringFunction(parseDb)));

    parametersList.push_back(std::make_unique<juce::AudioParameterBool>(
        juce::ParameterID { bypassId, 1 },
        "Bypass",
        false));

    return { parametersList.begin(), parametersList.end() };
}

void EffectPluginAudioProcessor::prepareToPlay(double sampleRate, int)
{
    trimGain.reset(sampleRate, 0.02);
    trimGain.setCurrentAndTargetValue(juce::Decibels::decibelsToGain(parameters.getRawParameterValue(trimId)->load()));
}

void EffectPluginAudioProcessor::releaseResources()
{
    trimGain.setCurrentAndTargetValue(1.0f);
}

bool EffectPluginAudioProcessor::isBusesLayoutSupported(const BusesLayout& layouts) const
{
    const auto mainOutput = layouts.getMainOutputChannelSet();
    const auto mainInput = layouts.getMainInputChannelSet();

    if (mainOutput != juce::AudioChannelSet::mono()
        && mainOutput != juce::AudioChannelSet::stereo())
        return false;

    return mainInput == mainOutput;
}

void EffectPluginAudioProcessor::processBlock(juce::AudioBuffer<float>& buffer, juce::MidiBuffer&)
{
    juce::ScopedNoDenormals noDenormals;

    for (auto channel = getTotalNumInputChannels(); channel < getTotalNumOutputChannels(); ++channel)
        buffer.clear(channel, 0, buffer.getNumSamples());

    if (parameters.getRawParameterValue(bypassId)->load() >= 0.5f)
        return;

    trimGain.setTargetValue(juce::Decibels::decibelsToGain(parameters.getRawParameterValue(trimId)->load()));

    for (int sample = 0; sample < buffer.getNumSamples(); ++sample)
    {
        const auto gain = trimGain.getNextValue();

        for (int channel = 0; channel < buffer.getNumChannels(); ++channel)
            buffer.getWritePointer(channel)[sample] *= gain;
    }
}

juce::AudioProcessorEditor* EffectPluginAudioProcessor::createEditor()
{
    return new EffectPluginAudioProcessorEditor(*this);
}

void EffectPluginAudioProcessor::getStateInformation(juce::MemoryBlock& destData)
{
    if (const auto state = parameters.copyState(); state.isValid())
    {
        std::unique_ptr<juce::XmlElement> xml(state.createXml());
        copyXmlToBinary(*xml, destData);
    }
}

void EffectPluginAudioProcessor::setStateInformation(const void* data, int sizeInBytes)
{
    std::unique_ptr<juce::XmlElement> xml(getXmlFromBinary(data, sizeInBytes));

    if (xml != nullptr && xml->hasTagName(parameters.state.getType()))
        parameters.replaceState(juce::ValueTree::fromXml(*xml));
}
}

juce::AudioProcessor* JUCE_CALLTYPE createPluginFilter()
{
    return new kratomix::EffectPluginAudioProcessor();
}
